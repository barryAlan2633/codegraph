# Codegraph environment configuration
# Copy to .env and fill in your values

# Path to the repository to analyse
CODEGRAPH_REPO_PATH=/path/to/your/repo

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Optional overrides (uncomment to use)
# CODEGRAPH_NEO4J_DATABASE=neo4j
# CODEGRAPH_MAX_FILE_SIZE_KB=512
# CODEGRAPH_LANGUAGES=["python","javascript","typescript","rust"]
